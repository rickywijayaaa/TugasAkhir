# Copy this file to .env and fill in your OpenAI API key
OPENAI_API_KEY=sk-your-openai-key-here

# Server config (optional, defaults shown)
HOST=127.0.0.1
PORT=8000

# Pipeline config (optional overrides — defaults match thesis Kel.3 config)
TOP_K_BM25=50
TOP_K_DENSE=50
TOP_K_AFTER_RRF=10
TOP_K_AFTER_RERANK=5
RRF_K=60
QR_TEMPERATURE=0.3
ANSWER_TEMPERATURE=0.2
